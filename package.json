{
  "name": "pi-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "pi 桌面客户端（Electron + React + TypeScript）",
  "author": "pi-desktop",
  "license": "MIT",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit --composite false -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit --composite false -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icon": "node scripts/build-icon.mjs",
    "icon:preview": "node scripts/build-icon.mjs --preview",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "package": "npm run build && electron-builder --dir --publish never",
    "package:dist": "npm run build && electron-builder --publish never",
    "test:e2e": "npm run build && vitest run --project e2e",
    "test:perf:memory": "npm run build && vitest run --project perf",
    "install:permission": "node scripts/install-permission-extension.mjs",
    "uninstall:permission": "node scripts/install-permission-extension.mjs --uninstall",
    "audit:security": "node scripts/audit-security.mjs",
    "status:permission": "node scripts/install-permission-extension.mjs --status"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "unified": "^11.0.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
